/* ------------------------------------------------------------
   LAYERING
   ------------------------------------------------------------ */

#viewport-container {
    z-index: 1 !important;
}

#top-toolbar-system {
    z-index: 1000 !important;
}

#left-panel,
#right-panel {
    z-index: 900 !important;
}


/* ============================================================
   MAGICXBF — AUTHORITATIVE TOP DRAWER
   ui.js owns the .open state.
   The handle remains docked; the toolbar content slides.
   ============================================================ */

#top-toolbar-system {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;

    height: 40px !important;
    max-height: 40px !important;

    z-index: 1000 !important;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;

    overflow: visible !important;
}

#top-toolbar-handle {
    position: relative !important;

    width: 100% !important;
    height: 40px !important;
    min-height: 40px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    box-sizing: border-box !important;

    z-index: 1002 !important;

    cursor: pointer !important;
    user-select: none !important;

    background: #3a4049 !important;
}

#top-toolbar-content {
    position: relative !important;

    width: 100% !important;
    box-sizing: border-box !important;

    display: flex !important;
    flex-direction: column !important;

    max-height: 0 !important;
    height: auto !important;

    padding: 0 !important;

    overflow: hidden !important;

    opacity: 0 !important;

    visibility: hidden !important;

    transition:
        max-height 0.30s ease,
        opacity 0.20s ease,
        padding 0.30s ease,
        visibility 0s linear 0.30s !important;
}

#top-toolbar-system.open {
    height: auto !important;
    max-height: 100vh !important;
}

#top-toolbar-system.open #top-toolbar-content {
    max-height: calc(100vh - 40px) !important;

    padding: 10px !important;

    opacity: 1 !important;

    visibility: visible !important;

    overflow-y: auto !important;
    overflow-x: hidden !important;

    transition:
        max-height 0.30s ease,
        opacity 0.20s ease,
        padding 0.30s ease,
        visibility 0s linear 0s !important;
}

#top-toolbar-content .toolbar-row {
    display: flex !important;
    align-items: center !important;

    visibility: visible !important;
    opacity: 1 !important;
}

#top-toolbar-content button,
#top-toolbar-content input {
    visibility: visible !important;
    opacity: 1 !important;
}

/* Keep the handle visually obvious. */
#top-toolbar-system:not(.open) #top-toolbar-handle::after {
    content: '▼';
    margin-left: 10px;
    font-size: 9px;
    opacity: 0.7;
}

#top-toolbar-system.open #top-toolbar-handle::after {
    content: '▲';
    margin-left: 10px;
    font-size: 9px;
    opacity: 0.7;
}

