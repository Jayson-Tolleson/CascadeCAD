:root {
    --bg-main: #282c34;
    --bg-panel: #21252b;
    --bg-toolbar: #323842;
    --bg-input: #2c313a;
    --bg-hover: #3a4049;
    --border-color: #454c59;
    --text-primary: #abb2bf;
    --text-secondary: #828a9a;
    --highlight-blue: #61afef;
    --highlight-green: #98c379;
    --highlight-red: #e06c75;
    --highlight-orange: #d19a66;
    --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-mono: 'SF Mono', 'Consolas', 'Menlo', monospace;
    --panel-width: 320px;
    --toolbar-height-collapsed: 40px;
    --toolbar-height-expanded: 280px;
    --z-panels: 10;
    --z-toolbar: 20;
    --z-viewport: 1;
    --z-statusbar: 5;
    --z-viewcube: 5;
}

/* --- BASE & LAYOUT --- */
body, html {
    margin: 0;
    padding: 0;
    font-family: var(--font-main);
    background-color: var(--bg-main);
    color: var(--text-primary);
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    font-size: 14px;
}

#magicxbf-app {
    position: relative;
    height: 100%;
    width: 100%;
}

#viewport-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-viewport);
}

#three-canvas {
    width: 100%;
    height: 100%;
    display: block;
}

/* --- TOP TOOLBAR SYSTEM --- */




#top-toolbar-handle {
    height: var(--toolbar-height-collapsed);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
    background-color: #3a4049;
}

#top-toolbar-handle:hover {
    background-color: var(--highlight-blue);
    color: var(--bg-main);
}

.handle-label {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    margin: 0 10px;
}

.handle-icon {
    width: 10px;
    height: 2px;
    background-color: currentColor;
    margin: 2px 0;
}

#top-toolbar-content {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.toolbar-row {
    display: flex;
    align-items: center;
    gap: 5px;
}

.toolbar-label {
    font-size: 11px;
    font-weight: bold;
    color: var(--text-secondary);
    width: 80px;
    text-align: right;
    margin-right: 10px;
    text-transform: uppercase;
}

.toolbar-row button {
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 4px 10px;
    border-radius: 3px;
    cursor: pointer;
    font-size: 12px;
}

.toolbar-row button:hover {
    border-color: var(--highlight-blue);
    color: var(--highlight-blue);
}

.toolbar-row button.active {
    background-color: var(--highlight-blue);
    color: var(--bg-main);
    font-weight: bold;
}

.toolbar-row .separator {
    width: 1px;
    height: 20px;
    background-color: var(--border-color);
    margin: 0 5px;
}

/* --- ENGINEERING ASSISTANT BAR --- */
#engineering-assistant-bar {
    display: flex;
    align-items: center;
    padding: 8px 10px;
    margin-top: 8px;
    background-color: #1c2025;
    border-top: 1px solid var(--border-color);
}

.assistant-label {
    font-size: 12px;
    font-weight: bold;
    color: var(--highlight-orange);
    margin-right: 15px;
}

#assistant-input {
    flex-grow: 1;
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 6px 10px;
    border-radius: 3px;
    font-size: 13px;
}

#assistant-input:focus {
    outline: none;
    border-color: var(--highlight-orange);
}

#assistant-execute, #assistant-expand {
    margin-left: 8px;
    background-color: var(--highlight-orange);
    color: var(--bg-main);
    border: none;
    padding: 6px 12px;
    border-radius: 3px;
    font-weight: bold;
    cursor: pointer;
}
#assistant-expand {
    padding: 6px 8px;
}

/* --- SLIDING SIDE PANELS --- */
.side-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--panel-width);
    background-color: var(--bg-panel);
    z-index: var(--z-panels);
    display: flex;
    transition: transform 0.3s ease-in-out;
    box-shadow: 0 0 15px rgba(0,0,0,0.5);
}

#left-panel {
    left: 0;
    transform: translateX(calc(-1 * var(--panel-width)));
    border-right: 1px solid var(--border-color);
}

#right-panel {
    right: 0;
    transform: translateX(var(--panel-width));
    border-left: 1px solid var(--border-color);
}

#left-panel.open { transform: translateX(0); }
#right-panel.open { transform: translateX(0); }

.panel-handle {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 60px;
    background-color: var(--bg-hover);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: var(--text-secondary);
    user-select: none;
}

.panel-handle:hover {
    background-color: var(--highlight-blue);
    color: white;
}

#left-panel-handle {
    right: -20px;
    border-radius: 0 5px 5px 0;
}

#right-panel-handle {
    left: -20px;
    border-radius: 5px 0 0 5px;
}

.panel-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.panel-section {
    padding: 15px;
    border-bottom: 1px solid var(--border-color);
}
.panel-section:last-child { border-bottom: none; }

.panel-content h4 {
    margin: 0 0 10px 0;
    font-size: 12px;
    text-transform: uppercase;
    color: var(--text-secondary);
    letter-spacing: 0.5px;
}

.panel-controls {
    display: flex;
    gap: 5px;
    margin-bottom: 10px;
}

.panel-controls input[type="search"] {
    width: 100%;
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 5px 8px;
    border-radius: 3px;
}

/* --- LEFT PANEL: ASSEMBLY & PROPERTIES --- */
#assembly-tree {
    list-style: none;
    padding: 0;
    margin: 0;
    height: 250px;
    overflow-y: auto;
    font-size: 13px;
}

#assembly-tree li {
    padding: 4px 8px;
    cursor: pointer;
    border-radius: 3px;
    user-select: none;
    display: flex;
    align-items: center;
}

#assembly-tree li:hover { background-color: var(--bg-hover); }
#assembly-tree li.selected { background-color: var(--highlight-blue); color: var(--bg-main); }
#assembly-tree ul { list-style: none; padding-left: 20px; }
.icon-assembly::before { content: '📁'; margin-right: 5px; }
.icon-part::before { content: '🧊'; margin-right: 5px; }

#properties-content .prop-group { margin-bottom: 10px; }
#properties-content label { display: block; font-size: 11px; color: var(--text-secondary); margin-bottom: 4px; }
#properties-content input { width: calc(100% - 12px); background-color: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-primary); padding: 5px; border-radius: 3px; }
.placeholder { font-style: italic; color: var(--text-secondary); }

/* --- RIGHT PANEL: TABS & CONTENT --- */
.tab-bar { display: flex; border-bottom: 1px solid var(--border-color); }
.tab-button { flex: 1; background: none; border: none; color: var(--text-secondary); padding: 10px; cursor: pointer; font-weight: bold; border-bottom: 3px solid transparent; }
.tab-button:hover { color: var(--text-primary); }
.tab-button.active { color: var(--highlight-blue); border-bottom-color: var(--highlight-blue); }

.tab-content { display: none; padding: 15px; overflow-y: auto; flex-grow: 1; }
.tab-content.active { display: block; }

#selection-info-content button {
    width: 100%;
    margin-top: 10px;
    padding: 8px;
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    cursor: pointer;
}
#selection-info-content button:hover { border-color: var(--highlight-blue); }

#assistant-workspace { display: flex; flex-direction: column; height: 100%; }
#assistant-output-log { flex-grow: 1; background-color: #1c2025; font-family: var(--font-mono); font-size: 12px; padding: 8px; overflow-y: auto; margin-bottom: 10px; border-radius: 3px; white-space: pre-wrap; }
#assistant-workspace-input { height: 100px; background-color: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-primary); padding: 8px; font-family: var(--font-mono); margin-bottom: 10px; }
#assistant-workspace-execute { background-color: var(--highlight-orange); color: var(--bg-main); border: none; padding: 8px; font-weight: bold; cursor: pointer; }

#telemetry-log { height: calc(100vh - 200px); overflow-y: scroll; background-color: #1c2025; font-family: var(--font-mono); font-size: 11px; padding: 5px; white-space: pre; }
#telemetry-log div { padding: 2px 5px; border-bottom: 1px solid #2a2f37; }
#telemetry-log .UI { color: var(--highlight-blue); }
#telemetry-log .API { color: var(--highlight-orange); }
#telemetry-log .ENGINE { color: var(--highlight-green); }
#telemetry-log .ERROR { color: var(--highlight-red); background-color: #4d2d30; }
#telemetry-log .WARNING { color: #ffd700; }
#telemetry-log .PERF { color: #c678dd; }

/* --- BOTTOM STATUS BAR --- */
#bottom-status-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 24px;
    background-color: rgba(33, 37, 43, 0.8);
    border-top: 1px solid var(--border-color);
    z-index: var(--z-statusbar);
    display: flex;
    align-items: center;
    padding: 0 15px;
    font-size: 12px;
    color: var(--text-secondary);
    gap: 20px;
}
#bottom-status-bar .spacer { flex-grow: 1; }
#status-message { color: var(--text-primary); }

/* --- VIEW CUBE --- */
#view-cube {
    position: absolute;
    top: calc(var(--toolbar-height-collapsed) + 15px);
    right: 15px;
    width: 80px;
    height: 80px;
    perspective: 400px;
    z-index: var(--z-viewcube);
    transition: top 0.3s ease-in-out;
}

#top-toolbar-system.open + #viewport-container #view-cube {
    top: calc(var(--toolbar-height-expanded) + 15px);
}

/* This is a placeholder for a real JS-driven view cube. */
#view-cube::before {
    content: 'VIEW';
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(33, 37, 43, 0.5);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-weight: bold;
    cursor: pointer;
}
#view-cube:hover::before {
    background-color: var(--highlight-blue);
    color: white;
}

/* --- RESPONSIVE --- */
@media (max-width: 768px) {
    :root {
        --panel-width: 280px;
    }
    .toolbar-row {
        flex-wrap: wrap;
    }
    .toolbar-label {
        width: 100%;
        text-align: left;
        margin-bottom: 5px;
    }
}


