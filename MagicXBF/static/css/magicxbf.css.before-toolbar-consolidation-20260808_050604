/* ------------------------------------------------------------
   16-WAY ORIENTATION GIZMO
   ------------------------------------------------------------ */

#view-cube {
    position: absolute !important;

    top: 58px !important;
    right: 18px !important;

    width: 118px !important;
    height: 142px !important;

    z-index: 950 !important;

    perspective: 650px !important;

    pointer-events: none !important;
}

.orientation-gizmo {
    position: relative;

    width: 118px;
    height: 142px;

    transform-style: preserve-3d;
}

/* Central cube */

.gizmo-cube {
    position: absolute;

    left: 20px;
    top: 10px;

    width: 78px;
    height: 78px;

    transform-style: preserve-3d;

    transform:
        rotateX(-22deg)
        rotateY(35deg);
}

/* Six primary cube faces */

.gizmo-face {
    position: absolute;

    width: 78px;
    height: 78px;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(255,255,255,0.42);
    border-radius: 3px;

    background: rgba(45,51,61,0.94);

    color: var(--text-primary);

    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.4px;

    cursor: pointer;

    pointer-events: auto;

    backface-visibility: visible;

    transition:
        background 0.12s ease,
        color 0.12s ease,
        border-color 0.12s ease;
}

.gizmo-face:hover {
    background: var(--highlight-blue);
    color: var(--bg-main);
    border-color: white;
}

.face-front {
    transform: translateZ(39px);
}

.face-back {
    transform: rotateY(180deg) translateZ(39px);
}

.face-right {
    transform: rotateY(90deg) translateZ(39px);
}

.face-left {
    transform: rotateY(-90deg) translateZ(39px);
}

.face-top {
    transform: rotateX(90deg) translateZ(39px);
}

.face-bottom {
    transform: rotateX(-90deg) translateZ(39px);
}


/* ------------------------------------------------------------
   ORIENTATION RING
   Eight intermediate directions surrounding the cube.
   ------------------------------------------------------------ */

.gizmo-ring {
    position: absolute;

    left: 0;
    top: 0;

    width: 118px;
    height: 104px;

    pointer-events: none;
}

.gizmo-point {
    position: absolute;

    width: 22px;
    height: 20px;

    padding: 0;

    border: 1px solid var(--border-color);
    border-radius: 3px;

    background: rgba(33,37,43,0.92);

    color: var(--text-secondary);

    font-size: 8px;
    font-weight: bold;

    cursor: pointer;

    pointer-events: auto;

    transition:
        background 0.12s ease,
        color 0.12s ease;
}

.gizmo-point:hover {
    background: var(--highlight-blue);
    color: var(--bg-main);
}

/* Eight positions */

.p0 { left: 48px; top: 0; }
.p1 { left: 82px; top: 8px; }
.p2 { left: 94px; top: 39px; }
.p3 { left: 84px; top: 72px; }

.p4 { left: 48px; top: 82px; }
.p5 { left: 12px; top: 72px; }
.p6 { left: 2px; top: 39px; }
.p7 { left: 12px; top: 8px; }


/* ------------------------------------------------------------
   FOUR DIAGONAL ORIENTATION BUTTONS
   ------------------------------------------------------------ */

.gizmo-corner-buttons {
    position: absolute;

    left: 22px;
    top: 94px;

    width: 74px;

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 3px;

    pointer-events: none;
}

.gizmo-corner-buttons button {
    height: 18px;

    padding: 0;

    border: 1px solid var(--border-color);
    border-radius: 2px;

    background: rgba(33,37,43,0.90);

    color: var(--text-secondary);

    font-size: 8px;
    font-weight: bold;

    cursor: pointer;

    pointer-events: auto;
}

.gizmo-corner-buttons button:hover {
    background: var(--highlight-blue);
    color: var(--bg-main);
}


/* Home */

.gizmo-home {
    position: absolute;

    left: 47px;
    top: 122px;

    width: 26px;
    height: 18px;

    padding: 0;

    border: 1px solid var(--border-color);
