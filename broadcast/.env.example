LFTR_APP_NAME="LFTR Next"
LFTR_HOST="0.0.0.0"
LFTR_PORT="8787"
LFTR_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
LFTR_GOOGLE_MAPS_API_KEY="replace-me"
LFTR_POSTGIS_DSN="postgresql:///lftr_next"
LFTR_POSTGIS_ENABLED="true"
LFTR_STREAM_TICK_HZ="1.0"
LFTR_TARGET_STREAM_FPS="5-10"
# ProviderCache resolves relative cache dirs under this project root.
LFTR_CACHE_ROOT="."
LFTR_PROVIDER_MODE="live"
LFTR_GFS_ENABLED="true"
LFTR_GFS_NCSS_BASE_URL="https://thredds.ucar.edu/thredds/ncss/grid/grib/NCEP/GFS/Global_0p25deg/Best"
LFTR_GFS_NCSS_FALLBACK_URL="https://thredds.ucar.edu/thredds/ncss/grid/grib/NCEP/GFS/Global_0p25deg/TwoD"
LFTR_GFS_TIMEOUT_SECONDS="8"
LFTR_GFS_TTL_SECONDS="900"
LFTR_GFS_MAX_GRID_POINTS="4096"
LFTR_GFS_CACHE_DIR=".cache/gfs"
LFTR_RTOFS_ENABLED="true"
LFTR_RTOFS_NOMADS_BASE="https://nomads.ncep.noaa.gov/pub/data/nccf/com/rtofs/prod"
LFTR_RTOFS_TIMEOUT_SECONDS="8"
LFTR_RTOFS_TTL_SECONDS="900"
LFTR_RTOFS_CACHE_DIR=".cache/rtofs"
LFTR_RTOFS_DEPTH_LEVELS="surface"
LFTR_RTOFS_MAX_GRID_POINTS="256"
LFTR_RTOFS_PROVIDER_MODE="live"
LFTR_POSTGIS_SCHEMA="lftr"
LFTR_SPATIAL_MODE="postgis"
LFTR_SPATIAL_TILE_DEG="1.0"
# PostGIS pre-render feature cache stores cloud/ocean/bait render recipes.
# PostGIS-first default: runtime reads/writes live cloud feature recipes when available and falls back to live extraction when empty/unavailable.
LFTR_RENDER_CACHE_ENABLED="true"
LFTR_RENDER_CACHE_PREFER_POSTGIS="true"
LFTR_RENDER_CACHE_WRITE_THROUGH="true"
# PostGIS cache only stores live-provider rows by default.
LFTR_RENDER_CACHE_ALLOW_DEGRADED="false"
LFTR_RENDER_CACHE_MAX_FEATURES="512"
LFTR_RENDER_CACHE_TTL_SECONDS="1800"
LFTR_GEOMETRY_SIMPLIFY_GLOBAL="0.2"
LFTR_GEOMETRY_SIMPLIFY_REGIONAL="0.05"
LFTR_GEOMETRY_SIMPLIFY_LOCAL="0.005"
LFTR_CHL_ENABLED="false"
LFTR_CHL_PROVIDER="disabled"
LFTR_CHL_ERDDAP_BASE="https://coastwatch.pfeg.noaa.gov/erddap"
LFTR_CHL_DATASET_ID=""
LFTR_CHL_TTL_SECONDS="21600"
LFTR_CHL_CACHE_DIR="data/cache/chlorophyll"
LFTR_USGS_ENABLED="false"
LFTR_USGS_SOURCE_FAMILY="mock"
LFTR_USGS_CACHE_DIR="data/cache/usgs"
LFTR_USGS_TIMEOUT_SECONDS="30"
LFTR_USGS_MAX_FEATURES="5000"
LFTR_USGS_MIN_AREA_KM2_GLOBAL="5.0"
LFTR_USGS_MIN_AREA_KM2_REGIONAL="0.25"
LFTR_USGS_MIN_AREA_KM2_LOCAL="0.01"
LFTR_USGS_SIMPLIFY_GLOBAL="0.01"
LFTR_USGS_SIMPLIFY_REGIONAL="0.0025"
LFTR_USGS_SIMPLIFY_LOCAL="0.0005"
LFTR_USGS_ARCGIS_URL=""
LFTR_USGS_ARCGIS_LAYER=""
LFTR_USGS_GEOJSON_PATH=""
LFTR_USGS_SHAPEFILE_ZIP_PATH=""
LFTR_USGS_DEFAULT_BBOX="-125,32,-117,38"
LFTR_LIGHTNING_ENABLED="false"
LFTR_LIGHTNING_PROVIDER="disabled"
LFTR_LIGHTNING_TTL_SECONDS="120"
LFTR_LIGHTNING_MAX_FLASHES="50"
LFTR_LIGHTNING_CACHE_DIR="data/cache/lightning"

# Broadcast/watch pass #9 runtime
LFTR_BROADCAST_DEFAULT_ROOM=default
LFTR_BROADCAST_MAX_MESSAGE_CHARS=2000
LFTR_BROADCAST_UPLOADS_ENABLED=false
LFTR_BROADCAST_UPLOAD_DIR=data/uploads/broadcast

# Installer/deployment defaults
LFTR_DOMAIN="lftr.biz"
LFTR_PORT="8787"
LFTR_HTTP_PORT="80"
LFTR_HTTPS_PORT="443"
LFTR_FIREWALL_PORTS="22,80,443"
LFTR_SERVICE_NAME="broadcast"
# Google Cloud / Vertex AI deployment placeholders.
# LFTR_* names are read by the app. Non-LFTR legacy names may also be written
# by the installer for gcloud/shell compatibility and are ignored safely by Pydantic.
LFTR_GOOGLE_PROJECT_ID="broadcaster-fishmap"
LFTR_GOOGLE_CLOUD_PROJECT="broadcaster-fishmap"
LFTR_GOOGLE_CLOUD_REGION="global"
LFTR_VERTEX_LOCATION="global"
LFTR_VERTEX_MODEL="gemini-2.5-flash"
LFTR_VERTEX_ENABLED="false"
LFTR_AI_PROVIDER="vertex"
LFTR_AI_AUTH_MODE="unset"
LFTR_GCP_KEY="/etc/broadcast/gcp-key.json"
GOOGLE_PROJECT_ID="broadcaster-fishmap"
GOOGLE_CLOUD_PROJECT="broadcaster-fishmap"
GOOGLE_CLOUD_REGION="global"
VERTEX_LOCATION="global"
VERTEX_MODEL="gemini-2.5-flash"
AI_PROVIDER="vertex"
GCP_KEY="/etc/broadcast/gcp-key.json"
GCP_NETWORK="default"
GCP_FIREWALL_RULE="lftr-broadcast-web"
GCP_TARGET_TAGS=""
CERTBOT_EMAIL="admin@lftr.biz"

# Broadcast STT: Chrome can use native Web Speech; Firefox falls back to /ws/stt.
LFTR_STT_ENABLED=true
LFTR_STT_PROVIDER=google
LFTR_STT_LANGUAGE_CODE=en-US
LFTR_STT_MODEL=latest_short
LFTR_STT_SAMPLE_RATE_HZ=48000
LFTR_STT_CHUNK_SECONDS=3.5
