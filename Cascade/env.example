CASCADE_CAD_HOST=127.0.0.1
CASCADE_CAD_PORT=8790
CASCADE_CAD_BASE_PATH=/cascade-cad
CASCADE_CAD_STORAGE=/var/lib/cascade-cad
CASCADE_CAD_MAX_UPLOAD_BYTES=8589934592
CASCADE_CAD_CHUNK_BYTES=16777216
CASCADE_CAD_STORAGE_RESERVE_BYTES=1073741824
CASCADE_CAD_PREVIEW_TOLERANCE=2.0
CASCADE_CAD_PREVIEW_ANGULAR_TOLERANCE=0.30
# Headless FreeCAD native import controls. FCStd bypasses Trimesh entirely.
CASCADE_CAD_FCSTD_IMPORT_TIMEOUT_SECONDS=3600
CASCADE_CAD_FCSTD_RECOMPUTE=1
CASCADE_CAD_FCSTD_INCLUDE_HIDDEN=0
CASCADE_CAD_WORKER_POLL_SECONDS=1.0
CASCADE_CAD_WORKER_THREADS=1
CASCADE_CAD_JOB_RECOVERY_LIMIT=1
CASCADE_CAD_SECRET_KEY=replace-with-a-long-random-value
# Maximum mesh triangles allowed when the STEP writer must fall back to
# planar triangular B-rep faces. Defaulted to 5,000,000 for the large-model build; monitor RAM and swap.
CASCADE_CAD_MAX_FACETED_STEP_TRIANGLES=5000000

# Long export controls.
CASCADE_CAD_STEP_EXPORT_TIMEOUT_SECONDS=3600
CASCADE_CAD_FACETED_STEP_CHUNK_TRIANGLES=1000
CASCADE_CAD_MAX_CSG_TRIANGLES=10000000

# Hard-speed faceted-solid conversion. Up to 60 unique component jobs may be
# staged, but only two isolated OCP subprocesses run simultaneously by default.
CASCADE_CAD_FACETED_WORKERS=2
CASCADE_CAD_FACETED_QUEUE_DEPTH=60
CASCADE_CAD_FACETED_MEMORY_BUDGET_GB=10
CASCADE_CAD_FACETED_CACHE_ENABLED=1
CASCADE_CAD_FACETED_CACHE_MAX_BYTES=21474836480
CASCADE_CAD_FACETED_DIRECT_OCP=1
CASCADE_CAD_FACETED_FREECAD_FALLBACK=1
CASCADE_CAD_FACETED_UNIFY_SAME_DOMAIN=1
