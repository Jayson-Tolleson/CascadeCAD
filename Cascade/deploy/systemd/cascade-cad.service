[Unit]
Description=CascadeCAD Quart application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jayson_tolleson
Group=jayson_tolleson
WorkingDirectory=/home/jayson_tolleson/Cascade
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/jayson_tolleson
Environment=XDG_CONFIG_HOME=/home/jayson_tolleson/.config
ExecStart=/home/jayson_tolleson/Cascade/venv/bin/hypercorn --bind 127.0.0.1:8790 --workers 1 --keep-alive 20 webcad_xbf.app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/jayson_tolleson/Cascade
MemoryHigh=1G
MemoryMax=1536M
OOMPolicy=continue
LimitNOFILE=65536
OOMScoreAdjust=-500
CPUWeight=200

[Install]
WantedBy=multi-user.target
