[Unit]
Description=CascadeCAD Quart application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cascadecad
Group=cascadecad
WorkingDirectory=/opt/cascade-cad
EnvironmentFile=-/etc/cascade-cad.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/cascade-cad
Environment=XDG_CONFIG_HOME=/var/lib/cascade-cad/.config
ExecStart=/opt/cascade-cad/.venv/bin/hypercorn --bind ${CASCADE_CAD_HOST}:${CASCADE_CAD_PORT} --workers 1 --keep-alive 20 webcad_xbf.app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cascade-cad
MemoryHigh=1G
MemoryMax=1536M
OOMPolicy=continue
LimitNOFILE=65536
OOMScoreAdjust=-500
CPUWeight=200

[Install]
WantedBy=multi-user.target
